// prisma/schema.prisma
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  hashedPassword String?
  role           String   @default("editor")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversations Conversation[]
  dashboards    Dashboard[]
  dataSources   DataSource[]
}

model DataSource {
  id            String   @id @default(cuid())
  name          String
  type          String   // "postgresql", "mysql", "bigquery"
  host          String?
  port          Int?
  database      String?
  connectionUri String?
  toolboxId     String
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  databaseDocId String?
  databaseDoc   DatabaseDoc? @relation(fields: [databaseDocId], references: [id])

  semanticModels SemanticModel[]
  conversations  Conversation[]
  dashboards     Dashboard[]
}

model SemanticModel {
  id           String     @id @default(cuid())
  dataSourceId String
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id])
  version      Int        @default(1)
  tables       Json
  relationships Json
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  metrics MetricDefinition[]
}

model MetricDefinition {
  id              String        @id @default(cuid())
  semanticModelId String
  semanticModel   SemanticModel @relation(fields: [semanticModelId], references: [id])
  name            String
  displayName     String
  description     String
  sqlExpression   String
  createdAt       DateTime      @default(now())
}

model Conversation {
  id           String      @id @default(cuid())
  title        String?
  dataSourceId String?
  dataSource   DataSource? @relation(fields: [dataSourceId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  messages Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  sqlGenerated   String?
  sqlResults     Json?
  metadata       Json?
  createdAt      DateTime     @default(now())
}

model Dashboard {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  dataSourceId String?
  dataSource   DataSource? @relation(fields: [dataSourceId], references: [id])

  panels DashboardPanel[]
}

model DashboardPanel {
  id          String    @id @default(cuid())
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  chartType   String
  title       String
  description String?
  sql         String
  config      Json      @default("{}")
  layout      Json      // {x, y, w, h}
  createdAt   DateTime  @default(now())
}

model DatabaseDoc {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dataSources DataSource[]
  tables      TableDoc[]
}

model TableDoc {
  id            String      @id @default(cuid())
  databaseDocId String
  databaseDoc   DatabaseDoc @relation(fields: [databaseDocId], references: [id], onDelete: Cascade)
  tableName     String
  displayName   String
  description   String?
  tags          String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  columns ColumnDoc[]

  @@unique([databaseDocId, tableName])
}

model ColumnDoc {
  id            String   @id @default(cuid())
  tableDocId    String
  tableDoc      TableDoc @relation(fields: [tableDocId], references: [id], onDelete: Cascade)
  columnName    String
  displayName   String
  description   String?
  dataType      String
  nullable      Boolean  @default(false)
  isPrimaryKey  Boolean  @default(false)
  isForeignKey  Boolean  @default(false)
  foreignTable  String?
  foreignColumn String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tableDocId, columnName])
}
